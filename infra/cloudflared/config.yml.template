# Generated by scripts/cf-tunnel-setup.sh — do not edit TUNNEL_ID by hand.
tunnel: __TUNNEL_ID__
credentials-file: /etc/cloudflared/__TUNNEL_ID__.json
metrics: 0.0.0.0:2000
# Cloudflare's edge terminates TLS and sets X-Forwarded-Proto: https, which is
# what OnlyOffice needs to build https self-URLs. No Traefik middleware needed.
originRequest:
  connectTimeout: 30s
  noHappyEyeballs: true
ingress:
  - hostname: __DOMAIN_APP__
    service: http://frontend:80
  - hostname: __DOMAIN_API__
    service: http://backend:3000
  - hostname: __DOMAIN_OFFICE__
    service: http://onlyoffice:80
    originRequest:
      # OnlyOffice generates absolute URLs from the Host it is given.
      httpHostHeader: __DOMAIN_OFFICE__
  - hostname: __DOMAIN_SIGN__
    service: http://docuseal:3000
  - hostname: __DOMAIN_PORTAINER__
    service: http://portainer:9000
  - hostname: __DOMAIN_DB__
    service: http://adminer:8080
  - service: http_status:404
