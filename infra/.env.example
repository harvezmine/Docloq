# ============================================================================
# DocLoq Infra — Environment Variables (Production VPS)
# cp .env.example .env && nano .env
# ============================================================================

# === Domains ===
DOMAIN_APP=docloq.site
DOMAIN_API=api.docloq.site
DOMAIN_OFFICE=office.docloq.site
DOMAIN_SIGN=sign.docloq.site

# === Core ===
NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# === PostgreSQL ===
POSTGRES_USER=docloq
POSTGRES_PASSWORD=ganti-password-kuat
POSTGRES_DB=docloq_db
# DATABASE_URL dikonstruksi otomatis dari variabel di atas

# === Redis ===
REDIS_URL=redis://redis:6379

# === MongoDB ===
MONGO_PASSWORD=ganti-password-kuat
# MONGO_URL dikonstruksi otomatis dari MONGO_PASSWORD

# === Authentication ===
JWT_SECRET=ganti-random-string-minimal-64-karakter
# Generate: openssl rand -hex 32

HCAPTCHA_ENABLED=false
HCAPTCHA_SECRET=

# === Encryption ===
# Generate: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=

# QR Code
QR_SIGNING_SECRET=ganti-random-secret
# QR_VERIFICATION_BASE_URL diset otomatis dari DOMAIN_APP

# === Key Management (Vault) ===
KEY_PROVIDER=vault
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=isi-setelah-vault-operator-init
VAULT_TRANSIT_KEY=docloq-master

# === Storage Provider ===
# Pilih: local | minio | r2
STORAGE_PROVIDER=r2

# --- Cloudflare R2 (production) ---
S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_DOCUMENTS_BUCKET=docloq-documents
S3_ARCHIVE_BUCKET=docloq-archive
S3_QR_BUCKET=docloq-qrcodes

# Upload
MAX_FILE_SIZE_MB=50

# === OnlyOffice ===
# URL diset otomatis dari DOMAIN_OFFICE dan DOMAIN_API

# === Malware Scanner ===
SCANNER_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# === AI Services ===
OPENAI_API_KEY=sk-proj-...
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=docloq_documents

# === Email (SMTP) ===
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@docloq.site

# === DocuSeal (Document Signing) ===
DOCUSEAL_API_KEY=
# DOCUSEAL_API_URL diset otomatis ke http://docuseal:3000

# === Blockchain (Polygon) — opsional ===
# Kontrak sudah ter-deploy di Amoy: 0x8CAeedf1dF7EE5119D18630EfC271C30cbc3909A
# Tidak perlu deploy ulang. Cukup pakai address + wallet yang sama, isi POL untuk gas.
BLOCKCHAIN_ENABLED=true
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
# Wallet anchoring (hanya wallet ter-authorize yang bisa anchor). JANGAN commit key asli.
POLYGON_PRIVATE_KEY=
POLYGON_CONTRACT_ADDRESS=0x8CAeedf1dF7EE5119D18630EfC271C30cbc3909A
BLOCKCHAIN_CONFIRMATIONS=2
# Mainnet (nanti): RPC https://polygon-rpc.com, CHAIN_ID 137 → deploy ulang, address baru
