# ============================================================================
# DocLoq — Home Server Production Environment
# Template — copy to .env and fill in. scripts/deploy-home.sh will not run without it.
# ============================================================================
# Secrets are blank here on purpose. Generate them with:
#   openssl rand -hex 24   (passwords)   /   openssl rand -hex 32   (keys)
# ENCRYPTION_MASTER_KEY must be exactly 64 hex chars (32 bytes).
#
# Anything marked  >>> NEEDS YOUR INPUT <<<  is a placeholder.
# ============================================================================

# === Domains ===
DOMAIN_APP=docloq.site
DOMAIN_API=api.docloq.site
DOMAIN_OFFICE=office.docloq.site
DOMAIN_SIGN=sign.docloq.site

# === PostgreSQL (generated) ===
POSTGRES_USER=docloq
POSTGRES_PASSWORD=
POSTGRES_DB=docloq_db

# === MongoDB (generated) ===
MONGO_PASSWORD=

# === Secrets (generated — rotating any of these invalidates existing data) ===
# JWT_SECRET            rotate => every session logged out
# ENCRYPTION_MASTER_KEY rotate => EVERY existing document becomes undecryptable
# QR_SIGNING_SECRET     rotate => previously issued QR codes stop verifying
# ONLYOFFICE_SECRET     rotate => open editors lose file access until reload
JWT_SECRET=
ENCRYPTION_MASTER_KEY=
QR_SIGNING_SECRET=
ONLYOFFICE_SECRET=
ADMIN_GATE_SECRET=
OSINT_WEBHOOK_KEY=

# === Key management ===
# local  = DEKs wrapped by ENCRYPTION_MASTER_KEY above. Survives reboots with
#          no manual step. This is the deploy default.
# vault  = DEKs wrapped by Vault Transit. Stronger, but Vault must be manually
#          unsealed after every reboot or documents cannot be decrypted.
#          Switch with scripts/vault-init-home.sh (safe: decryption dispatches
#          on the ciphertext prefix, so local-wrapped docs keep working).
KEY_PROVIDER=local
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_TRANSIT_KEY=docloq-master
ALLOW_LOCAL_KEY_FALLBACK=false

# === Storage ===
# local = Docker volume backend_storage. No external credentials needed.
# r2    = Cloudflare R2; fill the S3_* block below and set STORAGE_PROVIDER=r2.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/storage
MAX_FILE_SIZE_MB=50

# --- Cloudflare R2 (fill to switch)  >>> NEEDS YOUR INPUT if STORAGE_PROVIDER=r2 <<<
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_DOCUMENTS_BUCKET=docloq-documents
S3_ARCHIVE_BUCKET=docloq-archive
S3_QR_BUCKET=docloq-qrcodes

# === Captcha (Cloudflare Turnstile) ===
# !! CURRENTLY USING CLOUDFLARE'S PUBLIC TEST PAIR — ALWAYS PASSES !!
# The frontend image is built with the matching test SITE key. Captcha is
# effectively off; brute-force is held back only by the 15-req/15-min auth
# rate limiter. Replace both halves before this is used for real:
#   1. put the real secret below
#   2. ./scripts/switch-captcha.sh real
# Real site key found in the repo CI config: 0x4AAAAAADVVXAV9IObkcwD2
#   >>> NEEDS YOUR INPUT: Cloudflare dashboard -> Turnstile -> docloq.site -> Secret Key <<<
TURNSTILE_SECRET_KEY=

# === AI (OpenAI) ===
#   >>> NEEDS YOUR INPUT <<<  Without it: document analysis, DoKi chatbot,
#   AI Projects, embeddings and semantic search all fail. Everything else runs.
OPENAI_API_KEY=
AI_ANALYSIS_MODEL=gpt-5
AI_PROJECT_CHAT_MODEL=gpt-4.1-mini
AI_PROJECT_OUTPUT_MODEL=gpt-4.1
CHATBOT_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_QUALITY=high
AI_IMAGE_QUOTA_WEIGHT=5
AI_PROJECT_STUFF_BUDGET_CHARS=120000
AI_PROJECT_TOP_K=12
AI_PROJECT_CHUNK_CHARS=3200
AI_PROJECT_CHUNK_OVERLAP=400
AI_PROJECT_OUTPUT_MAX_TOKENS=8000
AI_PROJECT_MAX_OUTPUTS=50
AI_PROJECT_CHAT_LIMIT_24H=50
AI_PROJECT_MAX_SOURCES=10
AI_PROJECT_MAX_PER_ORG=20
PII_REDACTION_ENABLED=true
CHATBOT_RATE_LIMIT_PER_MINUTE=10

# === Qdrant (vector DB — self-hosted, no key needed) ===
QDRANT_API_KEY=
QDRANT_COLLECTION=docloq_documents
QDRANT_CHUNK_COLLECTION=docloq_chunks
QDRANT_KB_COLLECTION=doki_knowledge

# === Email (SMTP) ===
#   >>> NEEDS YOUR INPUT <<<  Without it: email OTP 2FA, password reset and
#   invitation emails silently fail. Password login still works.
#   Old deploy used Brevo: SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@docloq.site
SMTP_FROM_NAME=DocLoq
EMAIL_HELP_URL=https://docloq.site/contact

# === Malware scanner ===
SCANNER_ENABLED=true

# === OnlyOffice / editor ===
# (URLs are set in docker-compose.home.yml — do not duplicate them here)

# === DocuSeal (e-signature) ===
#   >>> NEEDS YOUR INPUT after first boot <<<  Open https://sign.docloq.site,
#   create the admin account, then Settings -> API -> copy the token here and
#   restart the backend. Signing features are inert until then.
DOCUSEAL_API_KEY=

# === Google OAuth (invite-only login) ===
# The values committed in backend/.env.example are EXPOSED in git history and
# must be treated as burned — rotate them in Google Cloud Console before use.
#   >>> NEEDS YOUR INPUT if you want "Sign in with Google" <<<
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.docloq.site/api/auth/google/callback

# === OSINT leak discovery ===
OSINT_TRACKING_ENABLED=true
OSINT_AUTOSCAN_ENABLED=false
OSINT_SEARCH_PROVIDERS=searxng,google_cse,serper
#   >>> OPTIONAL <<<  SearXNG (self-hosted, already in the stack) covers this
#   without any key. Fill these only if you want Google CSE / Serper too.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SERPER_API_KEY=
SERPER_MONTHLY_BUDGET=2500

# === OCR ===
OCR_LANG=eng+ind
OCR_TESSDATA_PATH=./vendor/tessdata
OCR_MIN_CONFIDENCE=55
OCR_ENABLE_OSD=true
OCR_RENDER_DPI=300

# === Post-quantum key wrapping (§53) ===
PQC_WRAP_ENABLED=false

# === Watermarking ===
DOWNLOAD_WATERMARK_ENABLED=true

# === Blockchain anchoring (Polygon Amoy) ===
# Contract is already deployed and reusable — no redeploy needed. To enable:
# set BLOCKCHAIN_ENABLED=true and fund POLYGON_PRIVATE_KEY's wallet with POL.
#   >>> OPTIONAL <<<
BLOCKCHAIN_ENABLED=false
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
POLYGON_CONTRACT_ADDRESS=0x8CAeedf1dF7EE5119D18630EfC271C30cbc3909A
POLYGON_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=2
POLYGON_MIN_BALANCE=0.5
AUDIT_ANCHOR_ENABLED=false
AUDIT_ANCHOR_EVERY_N=256
AUDIT_ANCHOR_CHECK_MINUTES=30
AUDIT_ANCHOR_INTERVAL_HOURS=6

# === Auth rate limits (§63) ===
AUTH_FORGOT_LIMIT=5
AUTH_RESET_LIMIT=10
AUTH_CHANGE_PASSWORD_LIMIT=10
AUTH_RECOVERY_WINDOW_MIN=15

# === Admin web-SSH console — HIGH RISK, keep off ===
SSH_CONSOLE_ENABLED=false
SSH_CONSOLE_HOST=
SSH_CONSOLE_PORT=22
SSH_CONSOLE_USER=
SSH_CONSOLE_HOST_FINGERPRINT=
SSH_CONSOLE_OTP_EMAIL=

# === Cloudflare Tunnel ===
# Mode A (preferred): run scripts/cf-tunnel-setup.sh with a Cloudflare API
#   token — it creates the tunnel, writes cloudflared/, and points DNS here.
#   >>> NEEDS YOUR INPUT: API token with Account:Cloudflare Tunnel:Edit
#       + Zone:DNS:Edit on docloq.site <<<
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=7644bc065a6f2d87aca679eb300af542
CLOUDFLARE_ZONE=docloq.site
# Mode B (fallback): paste a dashboard tunnel token and use the
#   tunnel-token compose profile instead.
CLOUDFLARE_TUNNEL_TOKEN=
