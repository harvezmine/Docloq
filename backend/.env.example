# =============================================
# DocLoq Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in values.

# === Core ===
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Trust X-Forwarded-* (set true behind Cloudflare/reverse proxy; auto-on in production)
TRUST_PROXY=false

# === Database (PostgreSQL via Docker) ===
DATABASE_URL=postgresql://user:password@localhost:5436/docloq_db

# === Rate Limiter Store (Redis via Docker) ===
REDIS_URL=redis://localhost:6379

# === Authentication ===
JWT_SECRET=your-jwt-secret-change-in-production

# === Captcha (Cloudflare Turnstile) ===
# Backend secret key. If unset, captcha is BYPASSED in dev and REQUIRED-but-failing
# in production. Frontend site key lives in frontend/.env (VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=

# === Google OAuth (invite-only — only pre-provisioned emails allowed) ===
# NOTE: a real client id/secret pair was committed here and is still reachable in
# git history — treat that pair as burned and rotate it in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: change to your real domain, e.g. https://api.docloq.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# === OnlyOffice ===
BACKEND_URL=http://localhost:3000
BACKEND_URL_DOCKER=http://host.docker.internal:3000
ONLYOFFICE_URL=http://localhost:8082
# Secret used to sign the short-lived file-access token OnlyOffice uses to fetch a
# document. MUST be set + stable: if unset, a random secret is generated per process, so
# every backend restart/deploy invalidates tokens of already-open editors → OnlyOffice
# fails to re-fetch the file and shows stale/partial content. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ONLYOFFICE_SECRET=

# === Upload Processing ===
# Encryption master key — 64-char hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# QR Code signing secret
QR_SIGNING_SECRET=your-qr-signing-secret
QR_VERIFICATION_BASE_URL=http://localhost:5173/verify

# === Post-Quantum Key Wrapping (Feature 2) ===
# Wrap each document key with a hybrid KEM (X25519 + ML-KEM-768) for post-quantum
# readiness ("harvest-now-decrypt-later"). Additive layer over envelope encryption;
# AES-256 file encryption is unchanged. Default OFF — when ON, NEW uploads use v2 and
# fall back to v1 automatically on any error (uploads never break). Existing v1 docs
# are untouched and still decrypt. Private KEM keys are wrapped by Vault/master key.
PQC_WRAP_ENABLED=false

# === Malware Scanner ===
SCANNER_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# === Storage Provider ===
# Options: local | minio | r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# --- Cloudflare R2 (production) ---
# STORAGE_PROVIDER=r2
# S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
# S3_DOCUMENTS_BUCKET=docloq-documents
# S3_ARCHIVE_BUCKET=docloq-archive
# S3_QR_BUCKET=docloq-qrcodes

# --- MinIO (dev/self-hosted) ---
# STORAGE_PROVIDER=minio
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=docloq-admin
# S3_SECRET_KEY=docloq-secret-key-change-me
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_DOCUMENTS_BUCKET=docloq-documents
# S3_ARCHIVE_BUCKET=docloq-archive
# S3_QR_BUCKET=docloq-qrcodes

# === Upload Limits ===
MAX_FILE_SIZE_MB=50

# === Key Management (Vault) ===
# Options: local | vault
KEY_PROVIDER=local
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=docloq-dev-token
VAULT_TRANSIT_KEY=docloq-master
# When KEY_PROVIDER=vault and Vault is unreachable: false (default) fails the upload
# (no silent downgrade); true allows falling back to the local master key.
ALLOW_LOCAL_KEY_FALLBACK=false

# === Email (Nodemailer) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@docloq.local
SMTP_FROM_NAME=DocLoq

# === AI Services ===
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
# Optional — only needed for a secured/cloud Qdrant instance
QDRANT_API_KEY=
QDRANT_COLLECTION=docloq_documents
# Chunk vectors live in their own collection so whole-document points (used by
# findSimilarDocuments via the recommend API) stay uncontaminated.
QDRANT_CHUNK_COLLECTION=docloq_chunks
# DoKi semantic knowledge base (built from the chatbot KB, indexed lazily on first query)
QDRANT_KB_COLLECTION=doki_knowledge

# --- AI Project context ---
# Total source text at or under the budget is sent whole (stuff mode); above it, only the
# top-K chunks by embedding are retrieved. ~120K chars ≈ 30K tokens ≈ $0.012/chat on gpt-4.1-mini.
AI_PROJECT_STUFF_BUDGET_CHARS=120000
AI_PROJECT_TOP_K=12
AI_PROJECT_CHUNK_CHARS=3200
AI_PROJECT_CHUNK_OVERLAP=400

# --- Studio outputs (Tier 2) ---
# Model for Studio text outputs (report/summary/slides/faq/...). Defaults to the stronger
# gpt-4.1 (not the cheaper analysis model) since these are the highest-value surface.
# Set to gpt-4.1-mini to lower cost.
AI_PROJECT_OUTPUT_MODEL=gpt-4.1
# Max completion tokens per generated output. A slide deck needs more room than a summary.
AI_PROJECT_OUTPUT_MAX_TOKENS=8000
# Stored outputs per project (revoked tombstones don't count).
AI_PROJECT_MAX_OUTPUTS=50

# --- Studio image outputs (Tier 4: mind map, infographic) ---
# Image model needs a verified OpenAI org (else 403). Fallbacks: gpt-image-1, dall-e-3.
AI_IMAGE_MODEL=gpt-image-2
# gpt-image quality tier for Studio diagrams: 'low' | 'medium' | 'high'. Default 'high' —
# far more legible text/layout for the small cost delta.
AI_IMAGE_QUALITY=high
# An image costs ~10-50x a text output, so image kinds decrement quota by this weight.
AI_IMAGE_QUOTA_WEIGHT=5

# --- Previously read by code but undocumented here ---
# Document analysis model. gpt-5 = highest quality (reasoning); the code auto-switches to
# max_completion_tokens + default temperature for gpt-5/o-series. Set gpt-4.1-mini for lower cost.
AI_ANALYSIS_MODEL=gpt-5
# AI-project chat model (decoupled from analysis so gpt-5 above doesn't drag chat along).
AI_PROJECT_CHAT_MODEL=gpt-4.1-mini
CHATBOT_MODEL=gpt-4o-mini
AI_PROJECT_CHAT_LIMIT_24H=50
AI_PROJECT_MAX_SOURCES=10
AI_PROJECT_MAX_PER_ORG=20

# Redact structured PII (email + phone) from document text before it is sent to
# OpenAI for embedding/analysis. Default ON — only narrows outbound data, never
# breaks decryption or downstream flow. Set to "false" to disable (e.g. A/B-testing
# analysis quality with vs. without redaction).
PII_REDACTION_ENABLED=true

# === OCR (tesseract.js) ===
# '+'-joined Tesseract language codes. Needs matching <lang>.traineddata in OCR_TESSDATA_PATH.
OCR_LANG=eng+ind
# Local tessdata dir (self-hosted, no CDN). Falls back to tesseract.js CDN if missing.
OCR_TESSDATA_PATH=./vendor/tessdata
# Retry OCR with aggressive enhancement when mean confidence is below this (0-100).
OCR_MIN_CONFIDENCE=55
# Auto-detect & correct page orientation (0/90/180/270) via Tesseract OSD.
# Needs osd.traineddata in OCR_TESSDATA_PATH. Set false to disable.
OCR_ENABLE_OSD=true
# DPI to render PDF pages at before OCR. 300 works best for typical documents;
# raising it interacts badly with the enhance upscale step.
OCR_RENDER_DPI=300

# === MongoDB (AI Cache) ===
# MONGO_URL is accepted as a legacy alias. Without either name the AI result cache is
# disabled and every analysis re-bills OpenAI.
MONGO_URI=mongodb://docloq:docloq-mongo-secret@localhost:27017/docloq_ai_cache?authSource=admin

# === Blockchain (Polygon) ===
# Default OFF. Turn on only after deploying the contract (see scripts/deploy.cjs).
# Start on Amoy testnet (free) before mainnet.
BLOCKCHAIN_ENABLED=false
# --- Amoy testnet (recommended first) ---
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
# --- Polygon mainnet (later) ---
# POLYGON_RPC_URL=https://polygon-rpc.com
# POLYGON_CHAIN_ID=137
# Dedicated anchoring wallet private key. NEVER commit a real key. Use a wallet
# that only holds gas funds. Get testnet POL from https://faucet.polygon.technology
POLYGON_PRIVATE_KEY=
# Filled in after deploy (printed by scripts/deploy.cjs)
POLYGON_CONTRACT_ADDRESS=
# Block confirmations to wait before marking a tx confirmed
BLOCKCHAIN_CONFIRMATIONS=2
# Superadmin low-balance alert threshold (POL/MATIC). Wallet below this → warning banner.
POLYGON_MIN_BALANCE=0.5
# PolygonScan API key for contract verification (optional)
POLYGONSCAN_API_KEY=

# === Tamper-Evident Audit Log Anchoring (Feature 1) ===
# Periodically anchors a Merkle root over each org's new audit entries on-chain so a
# full audit-table rewrite is detectable. Needs BLOCKCHAIN_ENABLED=true too. Default OFF.
# Hash-chaining itself is always on (free); only the on-chain anchoring is gated here.
AUDIT_ANCHOR_ENABLED=false
# Anchor an org once it accumulates this many un-anchored entries (whichever comes first
# with the time flush below). Smaller = faster tamper detection, more gas.
AUDIT_ANCHOR_EVERY_N=256
# How often the "threshold" check runs (minutes).
AUDIT_ANCHOR_CHECK_MINUTES=30
# Slow flush: anchor any remaining pending entries every N hours (detection window).
AUDIT_ANCHOR_INTERVAL_HOURS=6

# === Cloudflare (Production) ===
# CLOUDFLARE_TUNNEL_TOKEN=<tunnel-token-from-dashboard>
# CLOUDFLARE_ACCOUNT_ID=<account-id>
# TRUST_PROXY=true

# === DocuSeal (Document Signing) ===
DOCUSEAL_API_KEY=
DOCUSEAL_URL=http://localhost:3001

# === OSINT Document Tracking ===
# Per-org leak discovery: searches Google Programmable Search (CSE) for each tracked
# document's visible canary code (DLQ-{docCode}-{dlCode}).
# Tracking toggle (default ON; set false to disable the whole feature).
OSINT_TRACKING_ENABLED=true
# Background auto-scan cron: first run 5 min after boot, then every 24h. Default OFF.
OSINT_AUTOSCAN_ENABLED=false
# Web-search providers for discovery, tried in order (fallback chain). At least one
# must be configured or scans surface "search unavailable" (no longer a silent "0 leaks").
#   google_cse — Google Programmable Search (needs GOOGLE_CSE_KEY + GOOGLE_CSE_CX)
#   serper     — Serper.dev Google-results API (needs SERPER_API_KEY; 2500 free queries)
OSINT_SEARCH_PROVIDERS=google_cse,serper
# Google Programmable Search Engine — enable "Custom Search JSON API" on the key's GCP project.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Serper.dev API key (https://serper.dev) — fallback when Google CSE is down/unconfigured.
SERPER_API_KEY=
# Serper monthly credit budget — shown as the used/budget bar in the admin leak monitor.
SERPER_MONTHLY_BUDGET=2500
# Shared secret to authenticate the external leak-report webhook (POST /api/osint/webhook).
OSINT_WEBHOOK_KEY=

# === Admin Web-SSH Console (/kicawkicaw) — HIGH RISK, OFF by default ===
# A browser root/sudo shell to the VPS. Two DISTINCT secrets to open a session:
# the admin gate (to reach the console) + the SSH password (entered per session,
# never stored). Enable ONLY when you understand the risk. See plan
# docs/superpowers/plans/2026-07-13-admin-web-ssh-console.md.
SSH_CONSOLE_ENABLED=false
# Fixed SSH target — the client can NEVER choose a host (prevents pivot).
SSH_CONSOLE_HOST=
SSH_CONSOLE_PORT=22
# Prefer a NON-root sudoer to shrink blast radius.
SSH_CONSOLE_USER=
# Pin the host key (anti-MITM): sha256 hex of the server host key. Get it with:
#   ssh-keyscan -t ed25519 <host> | ssh-keygen -lf - -E sha256   (use the hex, no colons)
# If empty → trust-on-first-use (logs a warning). Setting it is strongly recommended.
SSH_CONSOLE_HOST_FINGERPRINT=
# Email that receives the SSH access OTP (second factor). Set = an emailed code is
# required to open a session; the code goes to THIS inbox only and the frontend never
# shows the address. Empty = no OTP (gate + SSH password only). Uses the SMTP_* mailer.
SSH_CONSOLE_OTP_EMAIL=
